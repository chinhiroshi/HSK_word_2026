{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "update": {
    "production": {
      "channel": "production",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
