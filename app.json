{
  "expo": {
    "name": "HSK受講者が作ったHSK単語帳",
    "slug": "hskhsk",
    "version": "2.32.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app.replit.hskhsk",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/871e0fc5-7b8c-4679-9141-2cdf27cbada4",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "locales": {
      "ja": "./locales/ja.json",
      "en": "./locales/en.json"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.replit.hskhsk",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": ["ja", "en"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5B8C85",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "app.replit.hskhsk"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9",
          "dark": {
            "backgroundColor": "#111827"
          }
        }
      ],
      "expo-web-browser",
      "expo-audio"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "871e0fc5-7b8c-4679-9141-2cdf27cbada4"
      }
    }
  }
}
